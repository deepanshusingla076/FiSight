{
  "name": "fisight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "dev:ml": "cd ml && python server.py",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:ml\"",
    "train": "cd ml && python train_model.py",
    "setup:ml": "cd ml && pip install -r requirements.txt",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/finance-guard.test.mjs",
    "docker:infra": "docker compose up -d ml postgres redis"
  },
  "dependencies": {
